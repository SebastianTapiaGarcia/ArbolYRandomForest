                }
            });

            // Group data by variable unique values
            const groups = {};
            phishingDataset.forEach(item => {
                const val = item[varName];
                if (!groups[val]) groups[val] = [];
                groups[val].push(item);
            });

            let weightedGiniSum = 0;
            let totalRows = phishingDataset.length;
            let html = `<div class="font-bold text-navy text-sm mb-2 border-b border-celeste pb-1 flex justify-between items-center">
