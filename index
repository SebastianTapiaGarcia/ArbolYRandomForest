                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 0.5,
                            grid: { color: '#DCE6F2' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // Initialize on Load
        window.onload = function() {
            populateTable();
            selectVariable('Urgencia');
            generateSyntheticData();
        };
    </script>
</body>
