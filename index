        // ================= GINI CALCULATION & STEP 1 =================
        function calculateGini(subset) {
            if (subset.length === 0) return 0;
            const total = subset.length;
            const countYes = subset.filter(item => item.Phishing === 'Sí').length;
            const countNo = subset.filter(item => item.Phishing === 'No').length;
            const pYes = countYes / total;
            const pNo = countNo / total;
            const gini = 1 - (pYes * pYes + pNo * pNo);
            return { total, countYes, countNo, gini };
        }

        function selectVariable(varName) {
            // Update button styles
            ['Urgencia', 'Remitente', 'Adjunto', 'Enlace_corto'].forEach(v => {
