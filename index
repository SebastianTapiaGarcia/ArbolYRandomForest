                        <div class="font-bold text-navy text-xs border-b border-celeste/40 pb-1">Rama: ${varName} = ${val}</div>
                        <div class="text-[11px] text-slate-600 flex justify-between"><span>Total elementos:</span> <strong>${stats.total}</strong></div>
                        <div class="text-[11px] text-slate-600 flex justify-between"><span>Phishing (Sí):</span> <span class="text-rose-700 font-semibold">${stats.countYes}</span></div>
                        <div class="text-[11px] text-slate-600 flex justify-between"><span>Legítimo (No):</span> <span class="text-emerald-700 font-semibold">${stats.countNo}</span></div>
                        <div class="text-[11px] text-navy font-bold pt-1 border-t border-celeste/40 flex justify-between">
                            <span>Índice Gini:</span>
                            <span class="bg-celeste px-1.5 py-0.5 rounded font-mono">${stats.gini.toFixed(3)}</span>
                        </div>
                    </div>
                `;
            }

            html += `</div>
                     <div class="mt-3 pt-2 border-t border-celeste flex justify-between items-center text-xs bg-white p-2.5 rounded-lg border">
                        <span class="font-bold text-navy">Gini Ponderado Total de la División:</span>
                        <span class="font-mono bg-navy text-white px-3 py-1 rounded font-bold text-sm">${weightedGiniSum.toFixed(3)}</span>
                     </div>`;

            document.getElementById('variable-analysis-result').innerHTML = html;
