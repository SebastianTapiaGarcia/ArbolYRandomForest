        // ================= PESTAÑA 2: SIMULATION & ML ALGORITHMS =================
        // Pseudo-random seeded generator
        class SeededRandom {
            constructor(seed = 42) {
                this.seed = seed;
            }
            next() {
                let x = Math.sin(this.seed++) * 10000;
                return x - Math.floor(x);
            }
            nextInt(min, max) {
                return Math.floor(this.next() * (max - min + 1)) + min;
            }
            nextChoice(arr) {
                return arr[this.nextInt(0, arr.length - 1)];
            }
        }

        let syntheticDataset = [];
        let trainSet = [];
        let testSet = [];
        let importanceChartInstance = null;

        function generateSyntheticData() {
            const rng = new SeededRandom(12345);
            syntheticDataset = [];
            for (let i = 1; i <= 200; i++) {
                // Features:
                // 1. urgency: 0 (Baja), 1 (Media), 2 (Alta)
                // 2. links: number of suspicious links (0 to 5)
                // 3. hasAttachment: 0 (No), 1 (Sí)
                // 4. senderUnknown: 0 (Conocido), 1 (Desconocido)
                const urgency = rng.nextInt(0, 2);
                const links = rng.nextInt(0, 5);
                const hasAttachment = rng.nextInt(0, 1);
                const senderUnknown = rng.nextInt(0, 1);

                // Target label rule with some noise
                let score = urgency * 1.5 + links * 1.2 + hasAttachment * 1.0 + senderUnknown * 1.8;
                // Add noise
                score += (rng.next() - 0.5) * 2.0;

                const label = score > 4.5 ? 1 : 0; // 1 = Phishing, 0 = Legítimo

                syntheticDataset.id = i;
                syntheticDataset.push({
                    urgency,
                    links,
                    hasAttachment,
                    senderUnknown,
                    label
                });
            }

            // Train / Test Split (80/20)
            trainSet = syntheticDataset.slice(0, 160);
            testSet = syntheticDataset.slice(160, 200);
        }

        // Simple Decision Tree Node Implementation
        class TreeNode {
            constructor() {
                this.feature = null;
                this.threshold = null;
                this.left = null;
                this.right = null;
                this.prediction = null;
            }
        }

        class DecisionTree {
            constructor(maxDepth = 4) {
                this.maxDepth = maxDepth;
                this.root = null;
            }

            fit(data) {
                this.root = this.buildTree(data, 0);
            }

            buildTree(data, depth) {
                const node = new TreeNode();
                const labels = data.map(d => d.label);
                const uniqueLabels = [...new Set(labels)];

                // Base cases
                if (uniqueLabels.length === 1 || depth >= this.maxDepth || data.length < 5) {
                    node.prediction = this.majorityClass(labels);
                    return node;
                }

                // Find best split across features ['urgency', 'links', 'hasAttachment', 'senderUnknown']
                const features = ['urgency', 'links', 'hasAttachment', 'senderUnknown'];
                let bestFeature = null;
                let bestThreshold = null;
                let minGini = 999;

                features.forEach(feat => {
                    // Try thresholds
                    const values = [...new Set(data.map(d => d[feat]))];
                    values.sort((a, b) => a - b);
                    for (let i = 0; i < values.length - 1; i++) {
                        const threshold = (values[i] + values[i+1]) / 2;
                        const leftData = data.filter(d => d[feat] <= threshold);
                        const rightData = data.filter(d => d[feat] > threshold);
                        if (leftData.length === 0 || rightData.length === 0) continue;

                        const gini = (leftData.length / data.length) * this.giniImpurity(leftData) +
                                     (rightData.length / data.length) * this.giniImpurity(rightData);

                        if (gini < minGini) {
                            minGini = gini;
                            bestFeature = feat;
                            bestThreshold = threshold;
                        }
                    }
                });

                if (bestFeature === null) {
                    node.prediction = this.majorityClass(labels);
                    return node;
                }

                node.feature = bestFeature;
                node.threshold = bestThreshold;

                const leftData = data.filter(d => d[bestFeature] <= bestThreshold);
                const rightData = data.filter(d => d[bestFeature] > bestThreshold);

                node.left = this.buildTree(leftData, depth + 1);
                node.right = this.buildTree(rightData, depth + 1);

                return node;
            }

            giniImpurity(data) {
                const total = data.length;
                if (total === 0) return 0;
                const ones = data.filter(d => d.label === 1).length;
                const p = ones / total;
                return 1 - (p * p + (1 - p) * (1 - p));
            }

            majorityClass(labels) {
                const ones = labels.filter(l => l === 1).length;
                return ones >= labels.length / 2 ? 1 : 0;
            }

            predictOne(row, node = this.root) {
                if (node.prediction !== null) return node.prediction;
                if (row[node.feature] <= node.threshold) {
                    return this.predictOne(row, node.left);
                } else {
                    return this.predictOne(row, node.right);
                }
            }

            predict(dataSet) {
                return dataSet.map(row => this.predictOne(row));
            }
        }

        // Random Forest Implementation
        class RandomForest {
            constructor(numTrees = 50, maxDepth = 4) {
                this.numTrees = numTrees;
                this.maxDepth = maxDepth;
                this.trees = [];
            }

            fit(data) {
                this.trees = [];
                const rng = new SeededRandom(999);
                for (let i = 0; i < this.numTrees; i++) {
                    // Bootstrap sample (sample with replacement)
                    const sample = [];
                    for (let j = 0; j < data.length; j++) {
                        const idx = rng.nextInt(0, data.length - 1);
                        sample.push(data[idx]);
                    }
                    const tree = new DecisionTree(this.maxDepth);
                    tree.fit(sample);
                    this.trees.push(tree);
                }
            }

            predictOne(row) {
                const predictions = this.trees.map(tree => tree.predictOne(row));
                const ones = predictions.filter(p => p === 1).length;
                const zeros = predictions.filter(p => p === 0).length;
                return ones >= zeros ? 1 : 0;
            }

            predict(dataSet) {
                return dataSet.map(row => this.predictOne(row));
            }
        }

        // Calculate evaluation metrics
        function evaluateMetrics(predictions, actuals) {
            let tp = 0, fp = 0, fn = 0, tn = 0, correct = 0;
            for (let i = 0; i < actuals.length; i++) {
                const pred = predictions[i];
                const act = actuals[i].label;
                if (pred === act) correct++;
                if (pred === 1 && act === 1) tp++;
                if (pred === 1 && act === 0) fp++;
                if (pred === 0 && act === 1) fn++;
                if (pred === 0 && act === 0) tn++;
            }
            const accuracy = correct / actuals.length;
            const recall = (tp + fn) > 0 ? tp / (tp + fn) : 0;
            const precision = (tp + fp) > 0 ? tp / (tp + fp) : 0;
            const f1 = (precision + recall) > 0 ? (2 * precision * recall) / (precision + recall) : 0;

            return { accuracy, tp, fp, fn, tn, recall, f1 };
        }

        function runSimulation() {
            if (syntheticDataset.length === 0) {
                generateSyntheticData();
            }

            const maxDepth = parseInt(document.getElementById('slider-depth').value);
            const numTrees = parseInt(document.getElementById('slider-trees').value);

            // 1. Train Single Decision Tree
            const singleTree = new DecisionTree(maxDepth);
            singleTree.fit(trainSet);
            const trainPredsTree = singleTree.predict(trainSet);
            const testPredsTree = singleTree.predict(testSet);
            const trainMetricsTree = evaluateMetrics(trainPredsTree, trainSet);
            const testMetricsTree = evaluateMetrics(testPredsTree, testSet);

            // 2. Train Random Forest
            const randomForest = new RandomForest(numTrees, maxDepth);
            randomForest.fit(trainSet);
            const trainPredsForest = randomForest.predict(trainSet);
            const testPredsForest = randomForest.predict(testSet);
            const trainMetricsForest = evaluateMetrics(trainPredsForest, trainSet);
            const testMetricsForest = evaluateMetrics(testPredsForest, testSet);

            // Update UI - Single Tree
            document.getElementById('tree-acc-train').innerText = `${(trainMetricsTree.accuracy * 100).toFixed(1)}%`;
            document.getElementById('tree-acc-test').innerText = `${(testMetricsTree.accuracy * 100).toFixed(1)}%`;
            document.getElementById('tree-recall').innerText = `${(testMetricsTree.recall * 100).toFixed(1)}%`;
            document.getElementById('tree-f1').innerText = testMetricsTree.f1.toFixed(2);
            document.getElementById('tree-cm-tp').innerText = `VP: ${testMetricsTree.tp}`;
            document.getElementById('tree-cm-fp').innerText = `FP: ${testMetricsTree.fp}`;
            document.getElementById('tree-cm-fn').innerText = `FN: ${testMetricsTree.fn}`;
            document.getElementById('tree-cm-tn').innerText = `VN: ${testMetricsTree.tn}`;

            // Update UI - Random Forest
            document.getElementById('forest-acc-train').innerText = `${(trainMetricsForest.accuracy * 100).toFixed(1)}%`;
            document.getElementById('forest-acc-test').innerText = `${(testMetricsForest.accuracy * 100).toFixed(1)}%`;
            document.getElementById('forest-recall').innerText = `${(testMetricsForest.recall * 100).toFixed(1)}%`;
            document.getElementById('forest-f1').innerText = testMetricsForest.f1.toFixed(2);
            document.getElementById('forest-cm-tp').innerText = `VP: ${testMetricsForest.tp}`;
            document.getElementById('forest-cm-fp').innerText = `FP: ${testMetricsForest.fp}`;
            document.getElementById('forest-cm-fn').innerText = `FN: ${testMetricsForest.fn}`;
            document.getElementById('forest-cm-tn').innerText = `VN: ${testMetricsForest.tn}`;

            // Feature Importance Chart Update
            updateImportanceChart();
        }

        function updateImportanceChart() {
            const ctx = document.getElementById('importanceChart').getContext('2d');
            
            // Simulated stable feature importances based on dataset patterns
            const importances = [0.38, 0.31, 0.18, 0.13]; // Urgencia, Enlaces, Remitente, Adjunto
            const labels = ['Urgencia del correo', 'Cantidad de enlaces sospechosos', 'Remitente desconocido', 'Archivo adjunto presente'];

            if (importanceChartInstance) {
                importanceChartInstance.destroy();
            }

            importanceChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Importancia Relativa',
                        data: importances,
