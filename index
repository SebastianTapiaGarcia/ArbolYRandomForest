                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-${Object.keys(groups).length} gap-3">`;

            for (let val in groups) {
                const stats = calculateGini(groups[val]);
                weightedGiniSum += (stats.total / totalRows) * stats.gini;
                html += `
